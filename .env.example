DATABASE_URL="postgresql://user:pass@localhost:5432/javs"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://your-domain/api/payments/mpesa/callback"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY="" # server-only secret: never prefix with NEXT_PUBLIC_, never commit
CRON_SECRET="another-long-random-string"
MPESA_ENV="sandbox"
NEXT_PUBLIC_WHATSAPP=""
APP_URL="https://your-domain"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE="ticket_confirmation"
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_REMINDER_TEMPLATE="trip_reminder"
WHATSAPP_UPDATE_TEMPLATE="trip_update"
NEXT_PUBLIC_MPESA_TILL="4308216"   # Buy Goods Till shown to customers
NEXT_PUBLIC_STK_ENABLED="false"    # set "true" once the Daraja STK keys below are added
MPESA_C2B_SECRET="long-random-string"
WHATSAPP_WAITLIST_TEMPLATE="seat_available"
SUPABASE_BUCKET="site-media" # public Storage bucket for homepage photos uploaded from the admin
# Email: no SMTP vars. Auth emails come from Supabase Auth; ticket emails from the send-email Edge Function.
# Its secrets (BREVO_API_KEY, EMAIL_FROM; or RESEND_API_KEY instead) are set with `supabase secrets set`, not here.

# --- SEO (all optional; see docs/SEO.md) ---
NEXT_PUBLIC_SITE_URL="https://javsofnairobi.co.ke"       # canonical host used in canonicals, sitemap and structured data
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""                   # token from Google Search Console (HTML tag method). Leave empty if you verify by DNS
NEXT_PUBLIC_BING_SITE_VERIFICATION=""                     # token from Bing Webmaster Tools (HTML tag method). Leave empty if you verify by DNS
NEXT_PUBLIC_GA_ID=""                                      # Google Analytics 4 measurement ID, like G-XXXXXXXXXX. Nothing loads when empty
NEXT_PUBLIC_SOCIAL_LINKS=""                               # comma-separated https:// URLs of your OFFICIAL profiles (adds schema.org sameAs). Leave empty until confirmed
