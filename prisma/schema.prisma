generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum Role { SUPER_ADMIN ADMIN BOOKING_MANAGER CONTENT_EDITOR FINANCE_MANAGER SUPPORT CUSTOMER }
enum SeatStatus { AVAILABLE RESERVED BOOKED }
enum BookingStatus { PENDING CONFIRMED CANCELLED EXPIRED REFUNDED }
enum PaymentStatus { INITIATED PENDING SUCCESS FAILED REVERSED REFUNDED }

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  phone String?
  passwordHash String
  role Role @default(CUSTOMER)
  bookings Booking[]
  loyalty LoyaltyEntry[]
  createdAt DateTime @default(now())
  deletedAt DateTime?
}
model Destination {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String
  lat Float?
  lng Float?
  imageUrl String?
  region String @default("")
  travelTime String @default("")
  budgetNote String @default("")
  activities String @default("")
  tips String @default("")
  trips Trip[]
}
model Vehicle {
  id String @id @default(cuid())
  name String
  capacity Int
  layout Json
  trips Trip[]
}
model Trip {
  id String @id @default(cuid())
  slug String @unique
  title String
  category String
  destinationId String
  destination Destination @relation(fields: [destinationId], references: [id])
  vehicleId String
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  departsAt DateTime
  meetingPoint String
  priceKes Int
  bookingFeeKes Int @default(0)
  imageUrl String?
  summary String @default("")
  tripType String @default("DAY")
  durationLabel String @default("")
  published Boolean @default(false)
  isSample Boolean @default(true)
  seats TripSeat[]
  bookings Booking[]
  reviews Review[]
  @@index([departsAt])
}
model TripSeat {
  id String @id @default(cuid())
  tripId String
  trip Trip @relation(fields: [tripId], references: [id])
  label String
  priceKes Int
  status SeatStatus @default(AVAILABLE)
  heldBy String?
  heldUntil DateTime?
  bookingId String?
  booking Booking? @relation(fields: [bookingId], references: [id])
  ticket Ticket?
  @@unique([tripId, label])
  @@index([status, heldUntil])
}
model Booking {
  id String @id @default(cuid())
  reference String @unique
  tripId String
  trip Trip @relation(fields: [tripId], references: [id])
  userId String?
  user User? @relation(fields: [userId], references: [id])
  guestEmail String?
  status BookingStatus @default(PENDING)
  totalKes Int
  seats TripSeat[]
  payments Payment[]
  tickets Ticket[]
  passengers BookingPassenger[]
  notifications Notification[]
  phone String?
  whatsappOptIn Boolean @default(false)
  promoCode String?
  discountKes Int @default(0)
  refunds Refund[]
  createdAt DateTime @default(now())
}
model Payment {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id])
  provider String
  idempotencyKey String @unique
  providerRef String? @unique
  amountKes Int
  status PaymentStatus @default(INITIATED)
  rawCallback Json?
  createdAt DateTime @default(now())
}
model Article {
  id String @id @default(cuid())
  slug String @unique
  title String
  category String
  excerpt String @default("")
  body String
  coverUrl String?
  author String @default("JAVS Editorial")
  publishedAt DateTime?
  archivedAt DateTime?
  comments Comment[]
}
model AuditLog {
  id String @id @default(cuid())
  actor String?
  action String
  detail Json?
  createdAt DateTime @default(now())
}

model Ticket {
  id String @id @default(cuid())
  token String @unique
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id])
  seatId String @unique
  seat TripSeat @relation(fields: [seatId], references: [id])
  passengerName String
  checkedInAt DateTime?
  checkedInBy String?
  review Review?
  createdAt DateTime @default(now())
}

model NganyaProfile {
  id String @id @default(cuid())
  name String
  crew String?
  bio String
  imageUrl String?
  createdAt DateTime @default(now())
}
model GalleryMedia {
  id String @id @default(cuid())
  url String
  caption String @default("")
  category String
  createdAt DateTime @default(now())
}
model Submission {
  id String @id @default(cuid())
  kind String
  title String
  body String
  contact String?
  status String @default("PENDING")
  createdAt DateTime @default(now())
}
model Comment {
  id String @id @default(cuid())
  articleId String
  article Article @relation(fields: [articleId], references: [id])
  name String
  body String
  approved Boolean @default(false)
  createdAt DateTime @default(now())
}

model BookingPassenger {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id])
  label String
  name String
  @@unique([bookingId, label])
}

model Notification {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id])
  channel String
  status String
  providerRef String? @unique
  error String?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([bookingId, channel])
}

model PromoCode {
  id String @id @default(cuid())
  code String @unique
  percentOff Int
  maxUses Int
  used Int @default(0)
  expiresAt DateTime?
  active Boolean @default(true)
}
model Waitlist {
  id String @id @default(cuid())
  tripId String
  contact String
  notifiedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([tripId, contact])
}
model Refund {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id])
  amountKes Int
  reason String
  actor String
  createdAt DateTime @default(now())
}

model Review {
  id String @id @default(cuid())
  tripId String
  trip Trip @relation(fields: [tripId], references: [id])
  ticketId String @unique
  ticket Ticket @relation(fields: [ticketId], references: [id])
  name String
  rating Int
  body String
  approved Boolean @default(false)
  createdAt DateTime @default(now())
}
model LoyaltyEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  bookingId String @unique
  points Int
  createdAt DateTime @default(now())
}

model Subscriber {
  id String @id @default(cuid())
  email String @unique
  createdAt DateTime @default(now())
}
